# Media Server settings. install.sh copies this to .env; update.sh never touches .env.
# Web port is set on the systemd unit (install.sh --port N); this is only used by `python -m app.cli run`.
MS_PORT=8099
# Where the database, thumbnails and transcode cache live (default: <install dir>/data)
# MS_DATA_DIR=/opt/media-server/data
# Where network shares added from the UI are mounted
MS_SHARES_DIR=/srv/media-server/shares
# Max simultaneous transcodes (each one is an ffmpeg process)
MS_MAX_TRANSCODES=3
# x264 preset for transcoding: ultrafast/superfast/veryfast/faster (faster = less CPU, bigger files)
MS_X264_PRESET=veryfast
# Legacy decode-only hw accel for the CPU path (leave empty). Since 1.5.2 use Settings > Transcoding instead.
MS_HWACCEL=
# Session lifetime in days
MS_SESSION_DAYS=30
# TMDB metadata (posters, overviews, episode titles). Get a free key at https://www.themoviedb.org/settings/api
# Either the "API Key" (v3) or the "API Read Access Token" (v4) works. You can also set it in Settings -> Metadata.
MS_TMDB_KEY=
# Language for titles/overviews, e.g. en-US, de-DE, fr-FR
MS_TMDB_LANGUAGE=en-US
# TMDB lookups in flight at once (1.2.1+; requests/s are still capped by MS_TMDB_MAX_RPS, default 20)
#MS_TMDB_WORKERS=4
# How many files are probed / thumbnailed at the same time during a scan (0 = auto: half the CPU cores, 2..4)
MS_SCAN_WORKERS=0
# 1.9: reverse proxies whose X-Forwarded-For / X-Real-IP / CF-Connecting-IP headers are trusted (comma-separated IPs
# or networks). 127.0.0.1 and ::1 are always trusted. You can also set this in Settings > System > Trusted proxies.
#MS_TRUSTED_PROXIES=192.0.2.10
