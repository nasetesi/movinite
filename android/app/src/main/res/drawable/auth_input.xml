<?xml version="1.0" encoding="utf-8"?>
<!-- 1.5: web inputs: panel2 fill, 1px line border, 8px corners; purple border when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="@color/panel2" /><corners android:radius="8dp" /><stroke android:width="1dp" android:color="@color/acc" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="@color/panel2" /><corners android:radius="8dp" /><stroke android:width="1dp" android:color="@color/line" /></shape></item>
</selector>
