<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/acc_fill" />
            <corners android:radius="@dimen/tv_btn_radius" />
            <stroke android:width="@dimen/tv_focus_stroke" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/acc_dark" />
            <corners android:radius="@dimen/tv_btn_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel" />
            <corners android:radius="@dimen/tv_card_radius" />
            <stroke android:width="1dp" android:color="@color/line" />
        </shape>
    </item>
</selector>
