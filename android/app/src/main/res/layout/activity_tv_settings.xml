<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tv_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:paddingLeft="96dp"
    android:paddingRight="96dp"
    android:paddingTop="72dp"
    android:paddingBottom="72dp">

    <LinearLayout
        android:layout_width="720dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tv_settings_title"
            android:textColor="@color/text"
            android:textSize="42sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:background="@drawable/tv_settings_card"
            android:orientation="vertical"
            android:paddingLeft="36dp"
            android:paddingRight="36dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_settings_user"
                android:textAllCaps="true"
                android:textColor="@color/muted"
                android:textSize="14sp"
                android:letterSpacing="0.08" />
            <TextView
                android:id="@+id/user_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/tv_settings_server"
                android:textAllCaps="true"
                android:textColor="@color/muted"
                android:textSize="14sp"
                android:letterSpacing="0.08" />
            <TextView
                android:id="@+id/server_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/tv_settings_version"
                android:textAllCaps="true"
                android:textColor="@color/muted"
                android:textSize="14sp"
                android:letterSpacing="0.08" />
            <TextView
                android:id="@+id/version_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/change_server"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/tv_btn_primary"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@id/sign_out"
            android:text="@string/tv_change_server"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/sign_out"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/tv_btn_ghost"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/change_server"
            android:text="@string/tv_sign_out"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
